{
  "name": "twilight-echo-app",
  "productName": "Stringmoon",
  "version": "0.4.1",
  "private": true,
  "description": "Stringmoon — a high-performance HiFi music player for Windows.",
  "author": "Stringmoon",
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "pack:dir": "electron-builder --win --dir",
    "dist": "node tools/release.mjs",
    "update-server": "node tools/update-server.mjs",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "check:tokens": "node tools/check-tokens.mjs",
    "test:c2": "node --test --experimental-strip-types tools/encodePath.test.ts",
    "test:app": "node --import ./tools/register-source.mjs --test tools/*.test.mjs",
    "test:electron": "node tools/run-electron-test.mjs",
    "test:player": "node tools/test-player-ui.mjs",
    "test:listening": "node tools/test-listening-ui.mjs",
    "test:startup": "node tools/test-startup-ui.mjs",
    "lint": "pnpm typecheck && pnpm check:tokens && pnpm check:css",
    "test:protocol": "node tools/test-mock-engine.mjs",
    "test:integration": "node tools/test-real-engine.mjs",
    "test:l2": "node --import ./tools/register-source.mjs tools/test-l2-integration.mjs",
    "test:library": "node tools/test-library-ui.mjs",
    "check:css": "node tools/check-css.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.57.0",
    "motion": "^14.2.0",
    "music-metadata": "^12.2.0",
    "node-id3": "0.2.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "playwright-core": "^1.64.0",
    "typescript": "~5.9.0",
    "vite": "^7.3.7"
  }
}
